{
  "name": "product-catalogue-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend REST API for the product catalogue and CMS system",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed:first-admin": "tsx src/seeders/createFirstAdmin.ts",
    "migrate:specification-pdf": "node database/applySpecificationPdfMigration.mjs",
    "migrate:enquiry-model": "node database/applyEnquiryModelMigration.mjs",
    "migrate:product-models": "node database/applyProductModelsMigration.mjs",
    "migrate:product-placement": "node database/applyProductPlacementMigration.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.4",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}
